
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Battle Fire Arena</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  background: #080d18;
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
  overflow: hidden;
}
header {
  padding: 12px;
  background: #111827;
  border-bottom: 2px solid #ff4d00;
}
h1 { margin: 4px; color: #ff5e00; }
#hud {
  display: flex;
  justify-content: space-around;
  padding: 10px;
  background: #182235;
  font-weight: bold;
}
#health { color: #42ff87; }
canvas {
  display: block;
  width: 100%;
  max-width: 900px;
  margin: auto;
  background: #263e35;
  touch-action: none;
}
#controls {
  display: flex;
  justify-content: center;
  gap: 14px;
  padding: 10px;
  background: #111827;
}
button {
  background: #ff5100;
  color: white;
  border: 0;
  border-radius: 10px;
  padding: 14px 20px;
  font-weight: bold;
  font-size: 16px;
}
#message { color: #ffd166; padding: 5px; }
</style>
</head>
<body>
<header>
  <h1>🔥 BATTLE FIRE ARENA</h1>
  <small>LAST PLAYER STANDING</small>
</header>

<div id="hud">
  <span id="health">❤️ HP: 100</span>
  <span id="kills">☠ Kills: 0</span>
  <span id="ammo">🔫 Ammo: 30</span>
</div>

<canvas id="game" width="800" height="480"></canvas>

<div id="message">Move with WASD / arrow keys. Aim and shoot with the buttons.</div>

<div id="controls">
  <button id="left">◀</button>
  <button id="shoot">🔥 SHOOT</button>
  <button id="right">▶</button>
  <button id="reload">↻ RELOAD</button>
</div>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

let player = { x: 400, y: 240, hp: 100 };
let enemies = [];
let bullets = [];
let kills = 0;
let ammo = 30;
let gameOver = false;
let keys = {};
let moveDirection = 0;
let lastShot = 0;

function spawnEnemy() {
  if (enemies.length >= 7 || gameOver) return;
  let side = Math.floor(Math.random() * 4);
  let x = side === 0 ? 0 : side === 1 ? 800 : Math.random() * 800;
  let y = side === 2 ? 0 : side === 3 ? 480 : Math.random() * 480;
  enemies.push({ x, y, hp: 2, speed: 0.55 + Math.random() * 0.5 });
}
for (let i = 0; i < 5; i++) spawnEnemy();

document.addEventListener("keydown", e => {
  keys[e.key.toLowerCase()] = true;
  if (e.key === " ") shoot();
});
document.addEventListener("keyup", e => keys[e.key.toLowerCase()] = false);

function holdButton(id, dir) {
  const el = document.getElementById(id);
  el.addEventListener("pointerdown", e => {
    e.preventDefault();
    moveDirection = dir;
  });
  ["pointerup", "pointerleave", "pointercancel"].forEach(ev =>
    el.addEventListener(ev, () => {
      if (moveDirection === dir) moveDirection = 0;
    })
  );
}
holdButton("left", -1);
holdButton("right", 1);
document.getElementById("shoot").addEventListener("click", shoot);

document.getElementById("reload").onclick = () => {
  ammo = 30;
  updateHUD();
};

function shoot() {
  if (gameOver || ammo <= 0 || Date.now() - lastShot < 220) return;
  lastShot = Date.now();
  ammo--;

  if (!enemies.length) {
    updateHUD();
    return;
  }

  let target = enemies.reduce((a, b) =>
    Math.hypot(a.x-player.x, a.y-player.y) <
    Math.hypot(b.x-player.x, b.y-player.y) ? a : b
  );

  let dx = target.x - player.x;
  let dy = target.y - player.y;
  let d = Math.hypot(dx, dy) || 1;
  bullets.push({
    x: player.x, y: player.y,
    vx: dx/d*7, vy: dy/d*7,
    target
  });
  updateHUD();
}

function updateHUD() {
  document.getElementById("health").textContent = "❤️ HP: " + player.hp;
  document.getElementById("kills").textContent = "☠ Kills: " + kills;
  document.getElementById("ammo").textContent = "🔫 Ammo: " + ammo;
}

function drawPlayer() {
  ctx.fillStyle = "#04c9ff";
  ctx.beginPath();
  ctx.arc(player.x, player.y, 13, 0, Math.PI*2);
  ctx.fill();
  ctx.fillStyle = "#ffffff";
  ctx.fillRect(player.x-5, player.y-4, 10, 8);
  ctx.fillStyle = "#ffcc00";
  ctx.fillRect(player.x+8, player.y-3, 17, 6);
}

function drawEnemy(e) {
  ctx.fillStyle = "#ff3c52";
  ctx.beginPath();
  ctx.arc(e.x, e.y, 12, 0, Math.PI*2);
  ctx.fill();
  ctx.fillStyle = "#260b16";
  ctx.fillRect(e.x-7, e.y-3, 14, 5);
}

function update() {
  if (gameOver) return;

  let speed = 3;
  if (keys["w"] || keys["arrowup"]) player.y -= speed;
  if (keys["s"] || keys["arrowdown"]) player.y += speed;
  if (keys["a"] || keys["arrowleft"]) player.x -= speed;
  if (keys["d"] || keys["arrowright"]) player.x += speed;
  player.x += moveDirection * speed;

  player.x = Math.max(15, Math.min(785, player.x));
  player.y = Math.max(15, Math.min(465, player.y));

  bullets.forEach(b => {
    b.x += b.vx;
    b.y += b.vy;
    if (Math.hypot(b.x-b.target.x, b.y-b.target.y) < 15 &&
        enemies.includes(b.target)) {
      b.target.hp--;
      b.x = -100;
      if (b.target.hp <= 0) {
        enemies = enemies.filter(e => e !== b.target);
        kills++;
        spawnEnemy();
      }
    }
  });
  bullets = bullets.filter(b => b.x >= 0 && b.x <= 800 &&
                                b.y >= 0 && b.y <= 480);

  enemies.forEach(e => {
    let dx = player.x-e.x, dy = player.y-e.y;
    let d = Math.hypot(dx,dy) || 1;
    if (d > 22) {
      e.x += dx/d*e.speed;
      e.y += dy/d*e.speed;
    } else {
      player.hp -= 0.12;
    }
  });

  if (player.hp <= 0) {
    player.hp = 0;
    gameOver = true;
    document.getElementById("message").textContent =
      "GAME OVER! Refresh the page to play again.";
  }
  updateHUD();
}

function draw() {
  ctx.clearRect(0,0,800,480);

  // Battlefield terrain
  ctx.fillStyle = "#294838";
  ctx.fillRect(0,0,800,480);
  ctx.strokeStyle = "#365844";
  ctx.lineWidth = 1;
  for (let x=0; x<800; x+=40) {
    ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,480); ctx.stroke();
  }
  for (let y=0; y<480; y+=40) {
    ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(800,y); ctx.stroke();
  }

  // Safe zone
  ctx.strokeStyle = "#00eaff";
  ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.arc(400,240,210,0,Math.PI*2);
  ctx.stroke();

  drawPlayer();
  enemies.forEach(drawEnemy);

  bullets.forEach(b => {
    ctx.fillStyle = "#ffe600";
    ctx.beginPath();
    ctx.arc(b.x,b.y,4,0,Math.PI*2);
    ctx.fill();
  });

  if (gameOver) {
    ctx.fillStyle = "rgba(0,0,0,0.75)";
    ctx.fillRect(0,0,800,480);
    ctx.fillStyle = "#ff4d4d";
    ctx.font = "bold 42px Arial";
    ctx.textAlign = "center";
    ctx.fillText("GAME OVER",400,230);
  }
}

function loop() {
  update();
  draw();
  requestAnimationFrame(loop);
}
loop();
</script>
</body>
</html>
